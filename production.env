# ============================================================
# RBZ Production Environment — keep this file chmod 600
# These values match what the database was initialised with.
# DO NOT change PII_ENCRYPTION_KEY — it would corrupt stored data.
# ============================================================

# Backend
JWT_SECRET=<replace_with_64_character_random_secret>
PII_ENCRYPTION_KEY=<replace_with_exactly_32_character_encryption_key>
CORS_ORIGINS=http://102.37.146.147
DB_URL=jdbc:postgresql://localhost:5432/rbz_db
DB_USERNAME=postgres
DB_PASSWORD=<replace_with_database_password>
DDL_AUTO=update
SERVER_PORT=8080
MAX_UPLOAD_SIZE=25MB

# Mail (disabled for testing)
MAIL_ENABLED=false

# AI service
GEMINI_API_KEY=<replace_with_gemini_api_key>
AZURE_FORM_RECOGNIZER_KEY=<replace_with_azure_form_recognizer_key>
