# ============================================================
# RBZ MICROFINANCE LICENSING SYSTEM — PRODUCTION ENV VARS
# Copy this to your server environment / deployment config.
# NEVER commit actual values to git.
# ============================================================
#
# REQUIRED (backend refuses to start if any of these are missing):
#   JWT_SECRET, CORS_ORIGINS, DB_URL, DB_USERNAME, DB_PASSWORD
#
# Generate JWT_SECRET with: openssl rand -hex 64
# ============================================================

# --- Spring Boot Backend ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://<host>:5432/rbz_db
DB_USERNAME=<db_user>
DB_PASSWORD=<strong_password>
# DDL_AUTO — two-phase deploy:
#   PHASE 1 (first-ever startup on a fresh DB): set to "update" so Hibernate creates all tables.
#   PHASE 2 (all subsequent restarts): change to "validate" so any schema drift is caught at boot.
#   After Phase 1 completes, dump the live schema: pg_dump --schema-only -U $DB_USERNAME $DB_NAME > schema.sql
#   Keep schema.sql in a secure location for future fresh installs (run it before setting DDL_AUTO=validate).
DDL_AUTO=update
# Minimum 64 characters. Run: openssl rand -hex 64
JWT_SECRET=<min_64_char_random_secret_generated_with_openssl_rand_hex_64>
# Production frontend URL (no trailing slash)
CORS_ORIGINS=https://yourdomain.com

# PII encryption key — exactly 32 characters (AES-256). Run: openssl rand -hex 16
PII_ENCRYPTION_KEY=<exactly_32_char_key_generated_with_openssl_rand_hex_16>

# --- Python AI Service ---
# Ollama runs locally on the same server (or another RBZ-controlled host) —
# no application data leaves the infrastructure.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AZURE_FORM_RECOGNIZER_KEY=<your_azure_key>
