[Unit]
Description=RBZ Licensing System — Python AI Service
After=network.target

[Service]
Type=simple
User=takilaa
WorkingDirectory=/home/takilaa/rbz/rbz_ai
EnvironmentFile=/home/takilaa/rbz/production.env
ExecStart=/home/takilaa/rbz/rbz_ai/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/takilaa/rbz/logs/ai.log
StandardError=append:/home/takilaa/rbz/logs/ai.log

[Install]
WantedBy=multi-user.target
